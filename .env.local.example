# --- WeLockin admin console environment ---

# Base URL of the WeLockin backend API (must end with /api).
# Production:
BACKEND_API_URL="https://app.connect.welock.in/api"
# Local backend during development:
# BACKEND_API_URL="http://localhost:8787/api"

# NOTE: the admin USERNAME / PASSWORD are NOT set here. They live in the
# backend's environment (ADMIN_USERNAME / ADMIN_PASSWORD). You log in through
# this app, which authenticates against the backend and stores a short-lived
# httpOnly session cookie.
